#!/usr/bin/env python3
"""The ⌘ on the status bar: a click opens a menu read from a plain file, so the file is the program.

    status-click <client> <pane>            write the menu as a tmux command (tmux.conf: a left click on the ⌘)
    status-click --do <client> <pane> <n> <hash>
                                            run line n of the file in a popup (what an sh: item calls),
                                            only if it is still the item the menu showed
    status-click --edit <client> <pane>     the file in an editor popup (a right click on the ⌘)
    status-click --bind                     tmux.conf, once: put --edit on the right click

The file is click-menu.conf beside tmux.conf and is read on every click: no reload after an edit.
Its header says how a line is written. A line that does not parse is drawn greyed out with its
line number, and the rest of the menu still works.

The click binding draws the menu itself, by sourcing what this script wrote beside the server's
socket. A menu that a background script opens was not opened by the mouse, so tmux gives it no
mouse: the click's own release closed it, and no item could be clicked.
"""
import hashlib
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

ME = Path(__file__).resolve()
MENU = Path(os.environ.get("STATUS_CLICK_MENU") or ME.parent.parent / "click-menu.conf")  # beside tmux.conf
KINDS = ("tmux:", "sh:")
GAP = re.compile(r"\t+| {2,}")  # between fields: tabs, or two spaces and more
ON_CLICK = "#{==:#{mouse_status_range},click}"  # true for a mouse key on tmux.conf's range=user|click


def tmux(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["tmux", *args], capture_output=True, text=True)


def items(text: str) -> list[tuple]:
    """(line number, label, key, kind, body) per item. kind "" is a separator, None a line that does not parse."""
    out: list[tuple] = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if line.startswith("#"):
            continue
        if not line:  # a blank line between two items draws a rule
            if out and out[-1][3] != "":
                out.append((n, "", "", "", ""))
            continue
        label, rest = GAP.split(line, maxsplit=1) if GAP.search(line) else (line, "")
        key = ""
        if not rest.startswith(KINDS) and GAP.search(rest):  # the key is optional
            key, rest = GAP.split(rest, maxsplit=1)
        kind = next((k for k in KINDS if rest.startswith(k)), None)
        body = rest[len(kind):].strip() if kind else ""
        if kind and body and len(key) <= 1:
            out.append((n, label, key, kind, body))
        else:
            out.append((n, raw.strip(), "", None, ""))
    while out and out[-1][3] == "":
        out.pop()
    return out


def read_items() -> list[tuple]:
    try:
        return items(MENU.read_text())
    except OSError:
        return []


def mark(label: str, body: str) -> str:
    """What the menu showed for an item, short: --do refuses a line whose label or code is no longer this."""
    return hashlib.sha256(f"{label}\0{body}".encode()).hexdigest()[:12]


def call(*argv: str, formats: str = "") -> str:
    """A tmux command that runs this script: argv quoted for run-shell's sh, `formats` left for tmux to fill."""
    return "run-shell -b '" + f"{shlex.join([str(ME), *argv])} {formats}".strip().replace("'", "'\\''") + "'"


def quote(arg: str) -> str:
    """One argument in tmux's config syntax: single quotes, nothing inside them is special."""
    return "'" + arg.replace("'", "'\\''") + "'"


def menu(client: str, pane: str) -> None:
    args, usable = [], False
    for n, label, key, kind, body in read_items():
        if kind == "":
            args.append("")
        elif kind is None:
            args += ["-" + f"line {n}: {label}"[:50].replace("#", "##"), "", ""]
        else:  # a tmux: body goes in as it is, and display-menu expands its formats for this client and pane
            args += [label, key, body if kind == "tmux:" else call("--do", client, pane, str(n), mark(label, body))]
            usable = True
    if not usable:  # an empty, missing or broken file: still a way in
        args += ["edit this menu", "e", call("--edit", client, pane)]
    # -O: the menu stays up after the click that opened it. R, S: right edge, the line above the bar,
    # clear of the pointer, so the button coming up never lands on an item.
    command = ["display-menu", "-O", "-t", pane, "-x", "R", "-y", "S", "-T", "#[align=centre] ⌘ ", *args]
    Path(os.environ["TMUX"].split(",")[0] + ".click-menu").write_text(" ".join(map(quote, command)) + "\n")


def popup(client: str, pane: str, title: str, code: str) -> None:
    """zsh code in a popup over the client: -i for his aliases and PATH, -EE keeps a failure on screen."""
    path = tmux("display-message", "-p", "-t", pane, "#{pane_current_path}").stdout.strip() or str(Path.home())
    tmux("display-popup", "-EE", "-c", client, "-w", "90%", "-h", "85%", "-d", path, "-T", f" {title} ",
         "-e", f"STATUS_PANE={pane}", "-e", f"STATUS_CLIENT={client}", "-e", f"STATUS_MENU={MENU}", "zsh", "-ic", code)


def do(client: str, pane: str, number: str, shown: str) -> None:
    """Line `number`, if it is still what the menu showed: the file is read again at the click, and an edit
    while the menu was open would otherwise run whatever sits on that line now."""
    for n, label, _, kind, body in read_items():
        if str(n) == number and kind == "sh:":
            if mark(label, body) != shown:
                break
            return popup(client, pane, label, body)
    tmux("display-message", "-c", client, f"click menu: line {number} changed since the menu opened; nothing run")


def bind() -> None:
    """Wrap the right click on the status bar: on the ⌘ it edits the file, elsewhere it is the menu it was."""
    was = tmux("list-keys", "-T", "root", "MouseDown3Status").stdout.strip().partition("MouseDown3Status")[2].strip()
    if not was.startswith("display-menu"):  # wrapped already, or not something to wrap
        return
    edit = call("--edit", formats="#{q:client_name} #{q:pane_id}")
    with tempfile.NamedTemporaryFile("w", suffix=".conf") as conf:
        conf.write(f'bind -n MouseDown3Status if -F "{ON_CLICK}" {{ {edit} }} {{ {was} }}\n')
        conf.flush()
        tmux("source-file", conf.name)


def main(args: list[str]) -> int:
    match args:
        case ["--do", client, pane, number, shown]:
            do(client, pane, number, shown)
        case ["--edit", client, pane]:
            popup(client, pane, "click-menu.conf", "${EDITOR:-nvim} $STATUS_MENU")
        case ["--bind"]:
            bind()
        case [client, pane] if not client.startswith("-"):
            try:  # run-shell shows what a job prints over the pane: say nothing, whatever happens
                menu(client, pane)
            except Exception:
                pass
        case _:
            print(__doc__.split("\n\n")[1], file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
