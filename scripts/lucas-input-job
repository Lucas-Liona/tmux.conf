#!/bin/sh
# status-left's #() job for Lucas's state: runs `state lucas --input` (typing, active or afk, from the time
# of his last keyboard or mouse input on Windows; no key is read) at most once every EVERY seconds for the
# whole server, in the background with its output closed, so the bar never waits for its ~1 s PowerShell.
# From the tmux server because its shells keep a live WSL interop socket; systemd and cron lost theirs
# when wslhost was killed (2026-11-18). The gate is window-models-job's: tmux starts a #() job on any
# redraw in a new second, once per client.
EVERY=${LUCAS_INPUT_EVERY:-30}
stamp="${TMUX%%,*}.lucas-input"
now=$(date +%s)
last=0
[ -r "$stamp" ] && read -r last < "$stamp"
[ $((now - ${last:-0})) -lt "$EVERY" ] && exit 0
echo "$now" > "$stamp"
# `set -g @lucas_input off` turns the read off altogether (Lucas, 2026-11-24: "turn off the status bar idle
# check too"); any other value, or none, and it runs. Asked after the gate, so tmux is asked every EVERY
# seconds and not on every redraw.
[ "$(tmux show -gqv @lucas_input 2>/dev/null)" = off ] && exit 0
"${STATE:-state}" lucas --input > /dev/null 2>&1 &
